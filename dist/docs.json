          {
            "name": "example",
            "text": "const result = await DeviceId.scanNetworkPrinters();\r\nconsole.log(result.printers);\r\n// [{ ip: \"192.168.1.45\", port: 9100 }, { ip: \"192.168.1.102\", port: 9100 }]"
